# passport.kiwimu.com 環境變數基準
#
# 這份檔案是「有哪些變數、各自幹什麼」的唯一稽核基準，**不放任何真實值**。
# 本機開發：複製成 .env.local 後填入實際值。
# production：值只存在 Vercel 專案設定（moonmoon-dessert-passport），不要寫回這裡。
#
# 標記說明
#   [前端] VITE_ 前綴＝會被打進 client bundle，任何人可讀 → 只能放公開值
#   [平台] 由 Vercel 自動注入，不需手動設定
#
# 本站是純 SPA（Vite），沒有自己的 serverless function，
# 所以**不應該出現任何無 VITE_ 前綴的密鑰**——需要 service_role 的操作
# 一律走 shop 的 API 或 Supabase RPC（SECURITY DEFINER），不在本站持有。

# ── Supabase（SSO 與 economy）────────────────────────────────
VITE_SUPABASE_URL=                    # [前端] Supabase 專案 URL（公開值）
VITE_SUPABASE_ANON_KEY=               # [前端] anon key（公開值，受 RLS 保護）
VITE_SUPABASE_AUTH_REDIRECT_URL=      # [前端] OAuth 回跳位址；需與 Supabase Auth 白名單一致
VITE_MOON_ISLAND_SUPABASE_URL=        # [前端] Moon Island 共用 DB URL（跨站 SSO 用；未設時 fallback 到 VITE_SUPABASE_URL）
VITE_MOON_ISLAND_SUPABASE_ANON_KEY=   # [前端] 對應的 anon key（公開值）

# ── LINE / 分析 ─────────────────────────────────────────────
VITE_LIFF_ID=                         # [前端] LINE LIFF app ID（公開值）
VITE_GA4_ID=                          # [前端] GA4 measurement ID（公開值）

# ── 建置開關 ────────────────────────────────────────────────
VITE_DISABLE_PWA=                     # [前端] '1' 或 'true' 時 build 不掛 PWA（除錯用，正式不要設）

# ── 平台自動注入（不需手動設定，列出僅供查閱）────────────────
# DEV                                 # [平台] Vite 的 import.meta.env.DEV

# ── 已移除，請勿再加 ─────────────────────────────────────────
# GEMINI_API_KEY / API_KEY
#   原本被 vite.config.ts 的 define 內聯進 client bundle，但 src/ 從未使用。
#   已於 2026-07-30 移除該注入。若日後需要 Gemini，改走 server 端代理，
#   不要在本站持有金鑰（純 SPA 藏不住任何密鑰）。
